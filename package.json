{
  "name": "literature",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time multiplayer Literature card game (3v3, 6 players)",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.2.4"
  }
}
