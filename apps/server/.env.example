# Copy this to .env (for local dev) or set in your deploy environment.

# Bind address and port. PORT=4000 by default in dev.
HOST=0.0.0.0
PORT=4000

# 'development' | 'production' | 'test'. Defaults to 'development'.
# In 'production', JWT_SECRET MUST be set (no fallback).
NODE_ENV=development

# Required in production. Must be at least 16 characters. Use `openssl rand -hex 32`.
# Rotating this invalidates every active session.
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed origins for CORS + Socket.IO.
# In dev you can leave it; defaults to http://localhost:5173.
CORS_ORIGIN=https://your-domain.example,https://www.your-domain.example

# Optional. If set, room state is persisted to Redis (survives restart).
# Without this, state is in-memory only.
# REDIS_URL=redis://localhost:6379

# Optional. How long a lobby room lives before being evicted if the game never starts.
# Default 30 * 60 * 1000 = 30 minutes.
# ROOM_TTL_MS=1800000
